PORT=8780

# Chat model/persona editing and live device status live in the Qiban platform
# studio (character-cloud). The bridge itself has no config UI.

# Set MOCK_MODE=echo to test board microphone, network and speaker without AI keys.
MOCK_MODE=

# Platform-owned speech-to-text service. Users never see this key.
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Platform-owned text-to-speech service. Users never see this key.
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=wav
TTS_PCM_SAMPLE_RATE=24000

# Multi-user mode: resolve the device owner and their encrypted chat settings
# through the Qiban platform. PLATFORM_API_URL is the public origin, without /api/v1.
PLATFORM_API_URL=
PLATFORM_BRIDGE_KEY=
# Only needed while the platform is behind the private Sites access layer.
PLATFORM_SITE_TOKEN=

# Single-device development fallback. Ignored when PLATFORM_API_URL is set.
DEVICE_TOKEN=replace-with-a-long-random-token
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=
SYSTEM_PROMPT=你是屏幕里的角色。请用自然、简短的中文回答，每次尽量不超过三句话。
